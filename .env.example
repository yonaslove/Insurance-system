# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=insurancedb
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=insurance_password

# Keycloak Configuration
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=insurance
KEYCLOAK_CLIENT_ID=insurance-web

# Eureka Discovery Server
EUREKA_HOST=discovery-server
EUREKA_PORT=8761

# API Gateway
GATEWAY_PORT=8080

# Service Ports
CUSTOMER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
POLICY_SERVICE_PORT=8083
CLAIMS_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085

# Frontend
FRONTEND_PORT=4200

# Mail Configuration (Defaults to local Mailpit webmail at http://localhost:8025)
# To send real emails to your personal Gmail inbox, set:
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_email@gmail.com
# SPRING_MAIL_PASSWORD=your_16_char_google_app_password
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

