# ==========================================
# InsurEdge Platform - Environment Template
# Copy this file to .env and configure secrets
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=insurancedb
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_secure_db_password_here

# Keycloak Identity & SSO
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_password_here
KEYCLOAK_REALM=insurance
KEYCLOAK_CLIENT_ID=insurance-web

# Eureka Discovery Server
EUREKA_HOST=discovery-server
EUREKA_PORT=8761

# API Gateway
GATEWAY_PORT=8080

# Microservice Exposed Ports
CUSTOMER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
POLICY_SERVICE_PORT=8083
CLAIMS_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085

# Frontend Web Application
FRONTEND_PORT=4200
